{
  "name": "agentic-support-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @madupe/web",
    "dev:web": "npm run dev -w @madupe/web",
    "dev:api": "npm run start:dev -w @madupe/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate -w @madupe/database",
    "prisma:migrate": "npm run prisma:migrate -w @madupe/database",
    "seed": "npm run seed -w @madupe/database",
    "supabase": "supabase"
  },
  "devDependencies": {
    "supabase": "^2.98.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
