{
  "name": "@madupe/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:types": "npm run build -w @madupe/shared && npm run prisma:generate -w @madupe/database",
    "build": "npm run prepare:types && tsc -p tsconfig.build.json",
    "lint": "npm run prepare:types && tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "test": "npm run prepare:types && node scripts/run-tests.cjs"
  },
  "dependencies": {
    "@madupe/shared": "0.1.0",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.105.4",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "bullmq": "^5.65.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "ioredis": "^5.8.2",
    "openai": "^4.76.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.20.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
