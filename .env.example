# Madupe local/deployment environment template.
# Copy to .env for local development, or map these keys into your hosting provider secret manager.
# Never commit real secrets.

# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
WEB_PORT=3001
LOG_LEVEL=info
TRUST_PROXY=true

# Public web configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
PUBLIC_API_URL=http://127.0.0.1:4000

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# AI triage
OPENAI_API_KEY=your-openai-api-key
OPENAI_TRIAGE_MODEL=gpt-4o-mini

# Security
# Generate with: openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-48-byte-base64-secret
CORS_ORIGINS=http://127.0.0.1:3001
ENABLE_API_DOCS=false
PUBLIC_GUEST_SESSION_TTL_MINUTES=1440

# Transactional email via Google SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_TIMEOUT_MS=8000
SMTP_TLS_REJECT_UNAUTHORIZED=false
SMTP_USER=your-google-workspace-address@example.com
SMTP_PASSWORD=your-google-app-password
MAIL_FROM="Madupe <support@example.com>"

# Distributed cache, rate limits, and background jobs.
# Required when NODE_ENV=production.
REDIS_URL=redis://127.0.0.1:6379
ENABLE_BACKGROUND_JOBS=false
ENABLE_REDIS_EVENTS=false
ENABLE_REDIS_RATE_LIMITS=false
